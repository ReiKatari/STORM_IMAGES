<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Files\AppIcon.ico</ApplicationIcon>
    <Version>0.0.3</Version>
    <AssemblyVersion>0.0.3.0</AssemblyVersion>
    <FileVersion>0.0.3.0</FileVersion>
    <AssemblyTitle>STORM IMAGES 0.0.3</AssemblyTitle>
    <Product>STORM IMAGES 0.0.3</Product>
    <Title>STORM IMAGES 0.0.3</Title>
    <Description>STORM IMAGES 0.0.3 - Installer</Description>
    <Company>STORM TEAM</Company>
    <Authors>STORM TEAM</Authors>
    <Copyright>Copyright © 2026 STORM TEAM</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\StormImages\bin\Release\net8.0-windows\win-x64\publish\StormImages.exe" Link="Payload\StormImages.exe" Condition="Exists('..\StormImages\bin\Release\net8.0-windows\win-x64\publish\StormImages.exe')" />
    <EmbeddedResource Include="..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe" Link="Payload\StormLauncher.exe" Condition="Exists('..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe')" />
    <EmbeddedResource Include="..\..\Files\STORM_Certificate.cer" Link="Payload\STORM_Certificate.cer" Condition="Exists('..\..\Files\STORM_Certificate.cer')" />
    <EmbeddedResource Include="..\..\Files\AppIcon.ico" Link="Payload\AppIcon.ico" Condition="Exists('..\..\Files\AppIcon.ico')" />
    <EmbeddedResource Include="Resources\header_badge.png" Link="Payload\header_badge.png" Condition="Exists('Resources\header_badge.png')" />
    <EmbeddedResource Include="Resources\badge_logo.png" Link="Payload\badge_logo.png" Condition="Exists('Resources\badge_logo.png')" />
    <EmbeddedResource Include="Resources\StormLogo.png" Link="Payload\StormLogo.png" Condition="Exists('Resources\StormLogo.png')" />
    <EmbeddedResource Include="..\..\Files\StormLogo.png" Link="Payload\StormLogoRoot.png" Condition="Exists('..\..\Files\StormLogo.png')" />
    <EmbeddedResource Include="..\StormImagesServer\app.py" Link="Payload\app.py" Condition="Exists('..\StormImagesServer\app.py')" />
    <EmbeddedResource Include="..\StormImagesServer\run_server.bat" Link="Payload\run_server.bat" Condition="Exists('..\StormImagesServer\run_server.bat')" />
    <EmbeddedResource Include="..\StormImagesServer\telegram_service.py" Link="Payload\telegram_service.py" Condition="Exists('..\StormImagesServer\telegram_service.py')" />
    <EmbeddedResource Include="..\StormImagesServer\README.md" Link="Payload\Server_README.md" Condition="Exists('..\StormImagesServer\README.md')" />
  </ItemGroup>

</Project>