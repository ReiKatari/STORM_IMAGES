<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Files\AppIcon.ico</ApplicationIcon>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <AssemblyTitle>STORM IMAGES 0.0.1</AssemblyTitle>
    <Product>STORM IMAGES 0.0.1</Product>
    <Title>STORM IMAGES 0.0.1</Title>
    <Description>STORM IMAGES 0.0.1 - Installer</Description>
    <Company>STORM TEAM</Company>
    <Authors>STORM TEAM</Authors>
    <Copyright>Copyright © 2026 STORM TEAM</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\StormImages\bin\Release\net8.0-windows\win-x64\publish\StormImages.exe" Link="Payload\StormImages.exe" Condition="Exists('..\StormImages\bin\Release\net8.0-windows\win-x64\publish\StormImages.exe')" />
    <EmbeddedResource Include="..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe" Link="Payload\StormLauncher.exe" Condition="Exists('..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe')" />
    <EmbeddedResource Include="..\..\Files\STORM_Certificate.cer" Link="Payload\STORM_Certificate.cer" Condition="Exists('..\..\Files\STORM_Certificate.cer')" />
    <EmbeddedResource Include="..\..\Files\AppIcon.ico" Link="Payload\AppIcon.ico" Condition="Exists('..\..\Files\AppIcon.ico')" />
    <EmbeddedResource Include="..\..\Files\logo.png" Link="Payload\logo.png" Condition="Exists('..\..\Files\logo.png')" />
  </ItemGroup>

</Project>