<UserControl x:Class="StormImages.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             xmlns:models="clr-namespace:StormImages.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoSettings}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Настройки приложения и хранилища" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                
                <!-- Output Folder Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Директория сохранения изображений" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Все сгенерированные изображения и метаданные параметров будут автоматически сохраняться в эту папку." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     Background="#0A0817"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding BrowseOutputDirectoryCommand}"
                                    Content="📁 Выбрать папку..."
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"/>

                            <Button Grid.Column="2"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Content="Открыть в Проводнике"
                                    Margin="6,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Theme Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Тема оформления" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Выберите визуальную тему интерфейса:" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <!-- Theme 1: Storm Midnight -->
                            <RadioButton GroupName="AppTheme"
                                         IsChecked="{Binding SelectedTheme, Converter={x:Null}}"
                                         Checked="ThemeMidnight_Checked"
                                         Cursor="Hand"
                                         Margin="0,0,8,0">
                                <Border Background="#15112B" BorderBrush="#A855F7" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Width="220">
                                    <StackPanel>
                                        <TextBlock Text="STORM MIDNIGHT" FontWeight="Bold" FontSize="12.5" Foreground="#A855F7"/>
                                        <TextBlock Text="Фиолетовый неон (По умолчанию)" FontSize="10" Foreground="#E9D5FF" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Theme 2: Storm Night -->
                            <RadioButton GroupName="AppTheme"
                                         Checked="ThemeNight_Checked"
                                         Cursor="Hand"
                                         Margin="4,0,4,0">
                                <Border Background="#0E1017" BorderBrush="#00C2E8" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Width="220">
                                    <StackPanel>
                                        <TextBlock Text="STORM NIGHT" FontWeight="Bold" FontSize="12.5" Foreground="#00C2E8"/>
                                        <TextBlock Text="Глубокий черный и циановый" FontSize="10" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Theme 3: Storm Day -->
                            <RadioButton GroupName="AppTheme"
                                         Checked="ThemeDay_Checked"
                                         Cursor="Hand"
                                         Margin="8,0,0,0">
                                <Border Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Width="220">
                                    <StackPanel>
                                        <TextBlock Text="STORM DAY" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                                        <TextBlock Text="Чистая светлая тема" FontSize="10" Foreground="#334155" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Backend Server Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoServer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Параметры AI-сервера инференса" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Адрес FastAPI/Diffusers сервера (локальный или удаленный GPU хост):" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>

                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Margin="0,0,0,14"/>

                        <CheckBox IsChecked="{Binding AutoStartBackend}" Margin="0,0,0,14">
                            <TextBlock Text="Автоматически запускать локальный AI-сервер при старте" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Save Action -->
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="💾 Сохранить все параметры"
                        Height="42"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource StormHeroGradient}"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="13"
                        BorderThickness="0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>