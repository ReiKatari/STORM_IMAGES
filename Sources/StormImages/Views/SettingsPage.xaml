<UserControl x:Class="StormImages.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoSettings}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Loc[SettingsTitle]}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                
                <!-- 1. Language Selector Card (6 Languages) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[LanguageSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <RadioButton Content="{Binding Loc[LangRu]}" IsChecked="{Binding IsRuSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="ru" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="{Binding Loc[LangEn]}" IsChecked="{Binding IsEnSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="{Binding Loc[LangDe]}" IsChecked="{Binding IsDeSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="de" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="{Binding Loc[LangFr]}" IsChecked="{Binding IsFrSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="fr" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="{Binding Loc[LangZh]}" IsChecked="{Binding IsZhSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="zh" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="{Binding Loc[LangJa]}" IsChecked="{Binding IsJaSelected, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="ja" Margin="0,0,10,8" Style="{DynamicResource StormNavRadioButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Output Folder Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[OutputFolderTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[OutputFolderDesc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     Background="#0A0817"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding BrowseOutputDirectoryCommand}"
                                    Content="{Binding Loc[BtnBrowseFolder]}"
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"
                                    Style="{DynamicResource StormSecondaryButton}"/>

                            <Button Grid.Column="2"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Content="{Binding Loc[BtnOpenFolder]}"
                                    Margin="6,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"
                                    Style="{DynamicResource StormSecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Visual Themes Card (All 8 Themes - Uniform Elevated 3D Cards) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[ThemeSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[ThemeSectionDesc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <!-- 1. STORM MIDNIGHT -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsMidnightSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormMidnight">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#A855F7" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeMidnight]}" FontWeight="Bold" FontSize="11.5" Foreground="#A855F7"/>
                                        <TextBlock Text="{Binding Loc[ThemeMidnightDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 2. STORM DARK -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsDarkSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormDark">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00D2FF" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeDark]}" FontWeight="Bold" FontSize="11.5" Foreground="#00D2FF"/>
                                        <TextBlock Text="{Binding Loc[ThemeDarkDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 3. STORM NIGHT -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsNightSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormNight">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00C2E8" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeNight]}" FontWeight="Bold" FontSize="11.5" Foreground="#00C2E8"/>
                                        <TextBlock Text="{Binding Loc[ThemeNightDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 4. STORM DAY -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsDaySelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormDay">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#0284C7" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeDay]}" FontWeight="Bold" FontSize="11.5" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding Loc[ThemeDayDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 5. STORM MATRIX -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsMatrixSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormMatrix">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00FF66" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeMatrix]}" FontWeight="Bold" FontSize="11.5" Foreground="#00FF66"/>
                                        <TextBlock Text="{Binding Loc[ThemeMatrixDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 6. STORM CYBERPUNK -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsCyberpunkSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormCyberpunk">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#FF007F" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeCyberpunk]}" FontWeight="Bold" FontSize="11.5" Foreground="#FF007F"/>
                                        <TextBlock Text="{Binding Loc[ThemeCyberpunkDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 7. STORM FANTASY -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsFantasySelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormFantasy">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#F59E0B" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeFantasy]}" FontWeight="Bold" FontSize="11.5" Foreground="#F59E0B"/>
                                        <TextBlock Text="{Binding Loc[ThemeFantasyDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 8. STORM WARHAMMER -->
                            <RadioButton GroupName="AppTheme" Style="{DynamicResource StormThemeCardRadioButton}"
                                         IsChecked="{Binding IsWarhammerSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}" CommandParameter="StormWarhammer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#D4AF37" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Loc[ThemeWarhammer]}" FontWeight="Bold" FontSize="11.5" Foreground="#D4AF37"/>
                                        <TextBlock Text="{Binding Loc[ThemeWarhammerDesc]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 4. Backend Server Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoServer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[ServerSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[ServerUrlLabel]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>

                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Margin="0,0,0,14"/>

                        <CheckBox IsChecked="{Binding AutoStartBackend}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Loc[ServerAutoStartCheck]}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Save Action -->
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="{Binding Loc[BtnSaveAll]}"
                        Height="44"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource StormHeroButton}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>