<UserControl x:Class="StormImages.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoSettings}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Loc[SettingsTitle]}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                
                <!-- 1. Language Selector Card (6 Languages) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[LanguageSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <RadioButton Content="🇷🇺 Русский" IsChecked="{Binding SelectedLanguage, Converter={x:Null}}" Checked="LangRu_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="🇬🇧 English" Checked="LangEn_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="🇩🇪 Deutsch" Checked="LangDe_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="🇫🇷 Français" Checked="LangFr_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="🇨🇳 中文" Checked="LangZh_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                            <RadioButton Content="🇯🇵 日本語" Checked="LangJa_Checked" Margin="0,0,12,8" Style="{DynamicResource StormNavRadioButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Output Folder Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[OutputFolderTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[OutputFolderDesc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     Background="#0A0817"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding BrowseOutputDirectoryCommand}"
                                    Content="{Binding Loc[BtnBrowseFolder]}"
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"
                                    Style="{DynamicResource StormSecondaryButton}"/>

                            <Button Grid.Column="2"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    Content="{Binding Loc[BtnOpenFolder]}"
                                    Margin="6,0,0,0"
                                    Padding="14,8"
                                    FontSize="12"
                                    Style="{DynamicResource StormSecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Visual Themes Card (All 8 Themes) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[ThemeSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[ThemeSectionDesc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <!-- 1. STORM MIDNIGHT -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeMidnight_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#15112B" BorderBrush="#A855F7" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM MIDNIGHT" FontWeight="Bold" FontSize="11" Foreground="#A855F7"/>
                                        <TextBlock Text="Аметистовая ночь" FontSize="9.5" Foreground="#E9D5FF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 2. STORM DARK -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeDark_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#0F172A" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM DARK" FontWeight="Bold" FontSize="11" Foreground="#00D2FF"/>
                                        <TextBlock Text="Тёмный кибер" FontSize="9.5" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 3. STORM NIGHT -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeNight_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#000000" BorderBrush="#00C2E8" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM NIGHT" FontWeight="Bold" FontSize="11" Foreground="#00C2E8"/>
                                        <TextBlock Text="Чёрный OLED" FontSize="9.5" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 4. STORM DAY -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeDay_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM DAY" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                                        <TextBlock Text="Светлая тема" FontSize="9.5" Foreground="#334155" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 5. STORM MATRIX -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeMatrix_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#051A10" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM MATRIX" FontWeight="Bold" FontSize="11" Foreground="#00FF66"/>
                                        <TextBlock Text="Матричный зелёный" FontSize="9.5" Foreground="#D1FAE5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 6. STORM CYBERPUNK -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeCyberpunk_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#1A0A26" BorderBrush="#FF007F" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM CYBERPUNK" FontWeight="Bold" FontSize="11" Foreground="#FF007F"/>
                                        <TextBlock Text="Неон Найт-Сити" FontSize="9.5" Foreground="#FCE7F3" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 7. STORM FANTASY -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeFantasy_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#1C1405" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM FANTASY" FontWeight="Bold" FontSize="11" Foreground="#F59E0B"/>
                                        <TextBlock Text="Королевское золото" FontSize="9.5" Foreground="#FEF3C7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- 8. STORM WARHAMMER -->
                            <RadioButton GroupName="AppTheme" Checked="ThemeWarhammer_Checked" Cursor="Hand" Margin="4">
                                <Border Background="#141416" BorderBrush="#D4AF37" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="STORM WARHAMMER" FontWeight="Bold" FontSize="11" Foreground="#D4AF37"/>
                                        <TextBlock Text="Имперская готика" FontSize="9.5" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 4. Backend Server Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoServer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[ServerSectionTitle]}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[ServerUrlLabel]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>

                        <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Margin="0,0,0,14"/>

                        <CheckBox IsChecked="{Binding AutoStartBackend}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Loc[ServerAutoStartCheck]}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Save Action -->
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="{Binding Loc[BtnSaveAll]}"
                        Height="44"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource StormHeroButton}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>