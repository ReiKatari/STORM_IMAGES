<UserControl x:Class="StormImages.Views.TelegramPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TelegramViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoSend}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Loc[TelegramTitle]}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration Form -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[TgTokenLabel]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8"
                             Background="#0A0817"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             BorderThickness="1"
                             FontSize="12"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding Loc[TgChatIdLabel]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ChatId, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8"
                             Background="#0A0817"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             BorderThickness="1"
                             FontSize="12"
                             Margin="0,0,0,14"/>

                    <!-- Auto-send CheckBox -->
                    <CheckBox IsChecked="{Binding AutoSend}" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Loc[TgAutoSendCheck]}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </CheckBox>

                    <TextBlock Text="{Binding Loc[TgCaptionLabel]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CaptionTemplate, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             Padding="8"
                             Background="#0A0817"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             BorderThickness="1"
                             FontSize="12"
                             Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Loc[TgVariablesHint]}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Button Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"
                                Content="{Binding Loc[BtnTestConnection]}"
                                Padding="16,8"
                                FontSize="12"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource StormSecondaryButton}"/>

                        <Button Command="{Binding SaveSettingsCommand}"
                                Content="{Binding Loc[BtnSaveSettings]}"
                                Padding="18,8"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource StormHeroButton}"/>
                    </Grid>

                    <TextBlock Text="{Binding TestStatus}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Guide Card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[TgInstructionsTitle]}" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[TgStep1Title]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc[TgStep1Desc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[TgStep2Title]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc[TgStep2Desc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[TgStep3Title]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc[TgStep3Desc]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>