<UserControl x:Class="StormImages.Views.TelegramPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TelegramViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoTelegram}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Интеграция с Telegram (Канал / Группа)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content Split: Settings + Instructions -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Bot Token Field -->
                        <TextBlock Text="Токен Telegram-бота (Bot Token):" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Margin="0,0,0,16"/>

                        <!-- Chat ID Field -->
                        <TextBlock Text="ID Чата / Канала (Chat ID или @username):" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ChatId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Margin="0,0,0,16"/>

                        <!-- Auto-send Option -->
                        <CheckBox IsChecked="{Binding AutoSend}" Margin="0,0,0,16">
                            <TextBlock Text="Автоматически публиковать каждую новую генерацию" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <!-- Caption Template -->
                        <TextBlock Text="Шаблон подписи к изображению:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CaptionTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 Padding="10,8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 FontSize="11.5"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="Доступные переменные: {prompt}, {seed}, {lora_scale}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding TestConnectionCommand}" Content="⚡ Проверить подключение" Margin="0,0,6,0" Padding="12,10" Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"/>
                            <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" Content="💾 Сохранить настройки" Margin="6,0,0,0" Padding="12,10"/>
                        </Grid>

                        <!-- Live Status Banner -->
                        <Border Background="#100C24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                Visibility="{Binding TestStatus, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding TestStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Guide Card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource GeoCheck}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Инструкция по настройке Telegram" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Border Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="1. Создание бота" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Откройте @BotFather в Telegram, отправьте команду /newbot, укажите имя и получите секретный HTTP API токен (например: 123456789:ABCdefGhIJKlmno)." FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="2. Добавление в канал или группу" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Добавьте созданного бота в администраторы вашего канала или группы с правами 'Публикация сообщений' (Post Messages)." FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="3. Получение Chat ID" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Для публичного канала можно указать @имя_канала (например @my_art_gallery). Для приватных каналов и групп ID начинается с -100 (например -1001987654321)." FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="4. Проверка связи" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Нажмите кнопку 'Проверить подключение', чтобы протестировать права доступа бота к указанному каналу." FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>