<UserControl x:Class="StormImages.Views.GenerationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GenerationViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Controls Column -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel Orientation="Vertical">
                
                <!-- 1. Mode Selector Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[ModeTextToImage]}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         IsChecked="{Binding IsTextToImageMode}"
                                         GroupName="GenModeGroup"
                                         Margin="0,0,4,0"
                                         Style="{DynamicResource StormNavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Loc[ModeTextToImage]}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         IsChecked="{Binding IsTextToImageMode, Converter={StaticResource InverseBoolConverter}}"
                                         GroupName="GenModeGroup"
                                         Margin="4,0,0,0"
                                         Style="{DynamicResource StormNavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Loc[ModeImageToImage]}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <TextBlock Text="{Binding Loc[ModeT2IDesc]}"
                                   Visibility="{Binding IsTextToImageMode, Converter={StaticResource BoolToVisConverter}}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[ModeI2IDesc]}"
                                   Visibility="{Binding IsTextToImageMode, Converter={StaticResource InverseBoolToVisConverter}}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. Model & LoRA Selector Card (Addressing where to choose models) -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoServer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Loc[ModelSelectionTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Base Model Dropdown -->
                        <TextBlock Text="{Binding Loc[BaseModelLabel]}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableBaseModels}"
                                  SelectedItem="{Binding SelectedBaseModel}"
                                  Margin="0,0,0,10"/>

                        <!-- LoRA Adapter Dropdown -->
                        <TextBlock Text="{Binding Loc[LoRAAdapterLabel]}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableLoRAs}"
                                  SelectedItem="{Binding SelectedLoRA}"
                                  Margin="0,0,0,10"/>

                        <Grid>
                            <Button Command="{Binding LoadModelCommand}"
                                    IsEnabled="{Binding IsModelLoading, Converter={StaticResource InverseBoolConverter}}"
                                    Content="{Binding Loc[BtnLoadModel]}"
                                    Padding="12,6"
                                    FontSize="11.5"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource StormSecondaryButton}"/>

                            <TextBlock Text="{Binding ModelLoadStatus}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Input Image Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoImages}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Loc[InputImageTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Button Command="{Binding ClearSourceImageCommand}"
                                    Visibility="{Binding SourceImageBitmap, Converter={StaticResource NullToVisibilityConverter}}"
                                    Content="{Binding Loc[BtnClearImage]}"
                                    HorizontalAlignment="Right"
                                    Padding="8,2"
                                    FontSize="10.5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <!-- Drop Zone / Image Preview -->
                        <Border x:Name="DropBorder"
                                Height="150"
                                Background="#0A0817"
                                BorderBrush="{DynamicResource AccentGlowBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Cursor="Hand"
                                AllowDrop="True"
                                Drop="DropBorder_Drop"
                                DragOver="DropBorder_DragOver"
                                MouseDown="DropBorder_MouseDown">
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SourceImageBitmap, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource AccentPrimaryBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Loc[InputImageDropHint]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Loc[InputImageOptional]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75"/>
                                </StackPanel>

                                <!-- Image Loaded Preview -->
                                <Image Source="{Binding SourceImageBitmap}"
                                       Stretch="Uniform"
                                       Visibility="{Binding SourceImageBitmap, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Button Command="{Binding SelectSourceImageCommand}"
                                Content="{Binding Loc[BtnSelectFile]}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource StormSecondaryButton}"/>
                    </StackPanel>
                </Border>

                <!-- 4. Prompt Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Loc[PromptTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="70"
                                 Padding="8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>

                        <!-- Quick Tags Chips -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{Binding Loc[TagMasterpiece]}" Command="{Binding AddPromptTagCommand}" CommandParameter="masterpiece, 8k resolution" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="{Binding Loc[TagPhotorealism]}" Command="{Binding AddPromptTagCommand}" CommandParameter="photorealistic portrait" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="{Binding Loc[TagCyberpunk]}" Command="{Binding AddPromptTagCommand}" CommandParameter="cyberpunk neon lighting, vibrant" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="{Binding Loc[TagCinematic]}" Command="{Binding AddPromptTagCommand}" CommandParameter="cinematic dramatic lighting" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="{Binding Loc[TagNsfw]}" Command="{Binding AddPromptTagCommand}" CommandParameter="nsfw" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="{Binding Loc[TagPortrait]}" Command="{Binding AddPromptTagCommand}" CommandParameter="studio portrait, sharp focus" Style="{DynamicResource QuickTagButton}"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding Loc[NegativePromptTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 Height="44"
                                 Padding="8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 5. Parameters Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <!-- LoRA Weight Slider -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[LoRAStrength]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LoRAScale, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="0.0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding LoRAScale}" Margin="0,0,0,10"/>

                        <!-- Steps Slider -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[InferenceSteps]}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Steps}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="60" Value="{Binding Steps}" Margin="0,0,0,10"/>

                        <!-- Guidance Scale Slider -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[GuidanceScale]}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding GuidanceScale, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="1.0" Maximum="15.0" SmallChange="0.5" Value="{Binding GuidanceScale}" Margin="0,0,0,10"/>

                        <!-- Seed Box -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RandomizeSeedCommand}" Content="{Binding Loc[BtnRandomSeed]}" Margin="6,0,0,0" Padding="8,4" FontSize="11" Style="{DynamicResource StormSecondaryButton}"/>
                            <Button Grid.Column="2" Command="{Binding ResetSeedCommand}" Content="{Binding Loc[BtnResetSeed]}" Margin="4,0,0,0" Padding="8,4" FontSize="11" Style="{DynamicResource StormSecondaryButton}"/>
                        </Grid>

                        <!-- Telegram Toggle (Square CheckBox) -->
                        <CheckBox IsChecked="{Binding SendToTelegram}" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Loc[TelegramAutoSend]}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Generate Action Button -->
                <Button Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                        Height="48"
                        Style="{DynamicResource StormHeroButton}"
                        Margin="0,0,0,6"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSparkles}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Loc[BtnGenerate]}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding GenerationStatus}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Canvas Column -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoGallery}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[CanvasTitle]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}}">
                        <Button Command="{Binding CopyResultCommand}" Content="{Binding Loc[BtnCopy]}" Margin="0,0,8,0" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormSecondaryButton}"/>
                        <Button Command="{Binding OpenResultFolderCommand}" Content="{Binding Loc[BtnOpenFolder]}" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormSecondaryButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Main Canvas View Area -->
                <Border Grid.Row="1"
                        Background="#080613"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Empty State Notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentGlowBrush}" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Loc[CanvasEmptyTitle]}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[CanvasEmptyDesc]}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Generated Result Preview -->
                        <Image Source="{Binding ResultImageBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Loading Indicator Overlay -->
                        <Border Background="#99000000"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding Loc[BtnGenerating]}" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer File Path Info -->
                <Grid Grid.Row="2" Margin="0,12,0,0"
                      Visibility="{Binding ResultFilePath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                    <TextBlock Text="{Binding ResultFilePath, StringFormat='Сохранено в: {0}'}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>