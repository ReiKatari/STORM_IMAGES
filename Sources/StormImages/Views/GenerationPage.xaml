<UserControl x:Class="StormImages.Views.GenerationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GenerationViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Controls Column -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel Orientation="Vertical">
                
                <!-- Input Image Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoImages}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Исходное изображение" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Drop Zone / Image Preview -->
                        <Border x:Name="DropBorder"
                                Height="180"
                                Background="#0A0817"
                                BorderBrush="{DynamicResource AccentGlowBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Cursor="Hand"
                                AllowDrop="True"
                                Drop="DropBorder_Drop"
                                DragOver="DropBorder_DragOver"
                                MouseDown="DropBorder_MouseDown">
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SourceImageBitmap, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <Path Data="{StaticResource GeoFolder}" Fill="{DynamicResource AccentPrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Нажмите или перетащите изображение сюда" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PNG, JPG, WEBP" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Image Loaded Preview -->
                                <Image Source="{Binding SourceImageBitmap}"
                                       Stretch="Uniform"
                                       Visibility="{Binding SourceImageBitmap, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <Button Command="{Binding SelectSourceImageCommand}"
                                Content="Выбрать файл..."
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Prompt Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Промпт (Prompt)" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="70"
                                 Padding="10"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>

                        <!-- Quick Tags Chips -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="+ Masterpiece" Command="{Binding AddPromptTagCommand}" CommandParameter="masterpiece, 8k resolution" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="+ Photorealism" Command="{Binding AddPromptTagCommand}" CommandParameter="photorealistic portrait" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="+ Cyberpunk" Command="{Binding AddPromptTagCommand}" CommandParameter="cyberpunk neon lighting, vibrant" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="+ Cinematic" Command="{Binding AddPromptTagCommand}" CommandParameter="cinematic dramatic lighting" Style="{DynamicResource QuickTagButton}"/>
                            <Button Content="+ NSFW LoRA" Command="{Binding AddPromptTagCommand}" CommandParameter="nsfw" Style="{DynamicResource QuickTagButton}"/>
                        </WrapPanel>

                        <TextBlock Text="Негативный промпт (Negative)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 Height="44"
                                 Padding="8"
                                 Background="#0A0817"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- LoRA & Parameters Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- LoRA Weight Slider -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Сила LoRA (Scottzilla NSFW):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LoRAScale, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="0.0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding LoRAScale}" Margin="0,0,0,12"/>

                        <!-- Steps Slider -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Шаги инференса (Steps):" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Steps}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="60" Value="{Binding Steps}" Margin="0,0,0,12"/>

                        <!-- Guidance Scale Slider -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Соответствие промпту (CFG):" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding GuidanceScale, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="1.0" Maximum="15.0" SmallChange="0.5" Value="{Binding GuidanceScale}" Margin="0,0,0,12"/>

                        <!-- Seed Box -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RandomizeSeedCommand}" Content="🎲 Random" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                            <Button Grid.Column="2" Command="{Binding ResetSeedCommand}" Content="Reset" Margin="4,0,0,0" Padding="8,4" FontSize="11"/>
                        </Grid>

                        <!-- Telegram Toggle -->
                        <CheckBox IsChecked="{Binding SendToTelegram}" Margin="0,4,0,0">
                            <TextBlock Text="✈️ Автоматически отправить в Telegram-канал" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Generate Action Button -->
                <Button Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                        Height="48"
                        Background="{DynamicResource StormHeroGradient}"
                        BorderThickness="0"
                        Margin="0,0,0,8"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSparkles}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="СГЕНЕРИРОВАТЬ ИЗОБРАЖЕНИЕ" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding GenerationStatus}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Preview & Canvas Column -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoGallery}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Холст результатов и сравнения" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}}">
                        <Button Command="{Binding CopyResultCommand}" Content="📋 Копировать" Margin="0,0,8,0" Padding="12,6" FontSize="11.5"/>
                        <Button Command="{Binding OpenResultFolderCommand}" Content="📁 Открыть папку" Padding="12,6" FontSize="11.5"/>
                    </StackPanel>
                </Grid>

                <!-- Main Canvas View Area -->
                <Border Grid.Row="1"
                        Background="#080613"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Empty State Notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Path Data="{StaticResource GeoMagic}" Fill="{DynamicResource AccentGlowBrush}" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Готовое изображение появится здесь" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Загрузите исходник слева, задайте промпт и нажмите 'Сгенерировать изображение'" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Generated Result Preview -->
                        <Image Source="{Binding ResultImageBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ResultImageBitmap, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Loading Indicator Overlay -->
                        <Border Background="#99000000"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="Нейросеть Qwen-Image-Edit обрабатывает изображение..." FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Применение LoRA весов Scottzilla NSFW" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer File Path Info -->
                <Grid Grid.Row="2" Margin="0,12,0,0"
                      Visibility="{Binding ResultFilePath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                    <TextBlock Text="{Binding ResultFilePath, StringFormat='Сохранено в: {0}'}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>