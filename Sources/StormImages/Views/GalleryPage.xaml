<UserControl x:Class="StormImages.Views.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoGallery}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Loc[GalleryTitle]}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" Content="{Binding Loc[BtnRefresh]}" Margin="0,0,8,0" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormSecondaryButton}"/>
                <Button Command="{Binding OpenFolderCommand}" Content="{Binding Loc[BtnOpenFolder]}" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormSecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Gallery Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Images Grid List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <!-- Empty Notice -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Items.Count, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                        <Path Data="{StaticResource GeoImages}" Fill="{DynamicResource TextMutedBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Loc[GalleryEmpty]}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Items List -->
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="140" ItemHeight="140" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#080613"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="4"
                                        Cursor="Hand">
                                    <Grid>
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" ClipToBounds="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Detail Metadata Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Image Preview -->
                    <Border Grid.Row="0"
                            Background="#080613"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,0,12">
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Metadata -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding Loc[GenInfoTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding Loc[PromptTitle]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Text="{Binding SelectedItem.Prompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5" MaxHeight="70" Margin="0,2,0,8"/>

                            <TextBlock Text="{Binding Loc[NegativePromptTitle]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Text="{Binding SelectedItem.NegativePrompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" MaxHeight="50" Margin="0,2,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[LoRAStrength]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedItem.LoRAScale, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[InferenceSteps]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedItem.Steps}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[GuidanceScale]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedItem.GuidanceScale, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[SeedLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedItem.Seed}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Loc[DateLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedItem.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <Button Command="{Binding DeleteSelectedCommand}" Content="{Binding Loc[BtnDelete]}" Margin="0,0,6,0" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormDangerButton}"/>
                        <Button Command="{Binding CopySelectedCommand}" Content="{Binding Loc[BtnCopy]}" Margin="0,0,6,0" Padding="12,6" FontSize="11.5" Style="{DynamicResource StormSecondaryButton}"/>
                        <Button Command="{Binding SendSelectedToTelegramCommand}" Content="{Binding Loc[BtnSendTelegram]}" Padding="14,6" FontSize="11.5" Style="{DynamicResource StormHeroButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>