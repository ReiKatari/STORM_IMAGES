<UserControl x:Class="StormImages.Views.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StormImages.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel}"
             Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource GeoGallery}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Галерея и история генераций" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} изображений'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" Content="🔄 Обновить" Margin="0,0,8,0" Padding="12,6" FontSize="11.5"/>
                <Button Command="{Binding OpenFolderCommand}" Content="📁 Открыть папку" Padding="12,6" FontSize="11.5"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Grid + Preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnails List View -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Height="210"
                                        Background="#0A0817"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="6"
                                        Cursor="Hand"
                                        MouseDown="GalleryItem_MouseDown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" CornerRadius="8,8,0,0" ClipToBounds="True" Background="#05030A">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="8,6">
                                            <TextBlock Text="{Binding Prompt}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Preview & Details Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <!-- Empty selection state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Path Data="{StaticResource GeoImages}" Fill="{DynamicResource AccentGlowBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Выберите изображение для просмотра" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Selected Item Details -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Big Image Preview -->
                            <Border Height="260" Background="#05030A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,14">
                                <Image Source="{Binding PreviewBitmap}" Stretch="Uniform"/>
                            </Border>

                            <!-- Metadata Info -->
                            <TextBlock Text="Информация о генерации" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <Border Background="#0A0817" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Промпт:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedItem.Prompt}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="LoRA Scale:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedItem.LoRAScale, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Seed:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedItem.Seed}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Шаги:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedItem.Steps}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Дата:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedItem.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Button Command="{Binding CopySelectedCommand}" Content="📋 Скопировать в буфер" Margin="0,0,0,8" Padding="12,8" HorizontalAlignment="Stretch"/>
                            <Button Command="{Binding SendSelectedToTelegramCommand}" Content="✈️ Отправить в Telegram-канал" Margin="0,0,0,8" Padding="12,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"/>
                            <Button Command="{Binding DeleteSelectedCommand}" Content="🗑️ Удалить изображение" Padding="12,8" HorizontalAlignment="Stretch" Background="#260810" BorderBrush="#591325"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>