<Window x:Class="StormImages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StormImages.ViewModels"
        mc:Ignorable="d"
        Title="STORM IMAGES" Height="860" Width="1360"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Icon="Assets/AppIcon.ico"
        Background="{DynamicResource AppBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="26" Height="26" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0">
                    <Image Source="Assets/logo.png" Width="26" Height="26" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="{Binding Loc[AppTitle]}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="0.0.2" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Window Caption Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnMinimize_Click" Width="46" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="🗕" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <Button Click="BtnMaximize_Click" Width="46" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <TextBlock x:Name="TxtMaximizeIcon" Text="🗖" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <Button Click="BtnClose_Click" Width="46" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideBarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,18,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="0">
                        <RadioButton IsChecked="True"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Generation"
                                     Style="{DynamicResource StormNavRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Loc[NavGeneration]}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="Gallery"
                                     Style="{DynamicResource StormNavRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoGallery}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Loc[NavGallery]}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="Telegram"
                                     Style="{DynamicResource StormNavRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSend}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Loc[NavTelegram]}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"
                                     Style="{DynamicResource StormNavRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSettings}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Loc[NavSettings]}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Footer: Server Quick Launcher -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource GeoServer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Loc[ServerStatusTitle]}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Button Command="{Binding LaunchBackendCommand}"
                                    Content="{Binding Loc[BtnStartServer]}"
                                    FontSize="11"
                                    Padding="10,6"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource StormSecondaryButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{Binding Backend.IsOnline, Converter={StaticResource BoolToColorConverter}}"/>
                    <TextBlock Text="{Binding Loc[StatusLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Backend.Status}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"/>

                    <TextBlock Text="{Binding Loc[ModelLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Backend.Model}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,16,0"/>

                    <TextBlock Text="{Binding Backend.Device}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Backend.VramUsedGb, StringFormat='{}VRAM: {0:F1} GB'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <TextBlock HorizontalAlignment="Right"
                           Text="{Binding Loc[FooterCopyright]}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>